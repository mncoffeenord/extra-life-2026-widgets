{
	"name": "extra-life-2026-widgets",
	"version": "0.1.0",
	"private": true,
	"description": "Self-hosted Extra Life stream overlay widgets (Streamlabs/OBS browser sources) backed by a local caching server.",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/server.ts",
		"dev": "node --watch src/server.ts",
		"mock": "node src/server.ts --mock",
		"test": "node --test \"test/**/*.test.ts\"",
		"typecheck": "tsc -p .",
		"check": "npm run typecheck && npm test",
		"record-fixtures": "node scripts/record-fixtures.ts",
		"setup": "node scripts/setup.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mncoffeenord/extra-life-2026-widgets.git"
	}
}
